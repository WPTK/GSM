# Copy to deploy/.env (cp deploy/.env.example deploy/.env), then fill in the four required values.
# deploy/.env is git-ignored. Never commit it. Values below are placeholders only.
#
# Docker secrets alternative: each required value also accepts a *_FILE variant (API_SECRET_FILE,
# ENCRYPTION_KEY_FILE, ANTHROPIC_API_KEY_FILE, GITHUB_TOKEN_FILE) holding a path to a file with
# the value. To use it, mount the file into the container and pass the *_FILE variable in a
# compose override; the plain variables above must then still be set (compose requires them), so
# for most single-host installs the plain .env is simpler and is what this file assumes.

# REQUIRED. Login password for the web UI and API. Also the key the session cookie is derived
# from: changing it signs everyone out. Generate with: openssl rand -hex 32
API_SECRET=<generate-with-openssl-rand-hex-32>

# REQUIRED. Encrypts secrets stored in the database. Generate once with: openssl rand -hex 32
# Changing it later makes already-stored encrypted values unreadable.
# Migrating an old install? If it had data/.encryption-key, put that exact value here.
ENCRYPTION_KEY=<generate-with-openssl-rand-hex-32>

# REQUIRED. Anthropic API key. Create one at https://console.anthropic.com/ (API keys).
ANTHROPIC_API_KEY=<anthropic-api-key-from-console.anthropic.com>

# REQUIRED. GitHub fine-grained personal access token. Scopes: see deploy/README.md.
GITHUB_TOKEN=<github-fine-grained-token>

# Optional. Host port, published on 127.0.0.1 only. Default 8765.
# GSM_PORT=8765

# Optional. Host directory for backups (Phase 5). Must be owned by uid 1000: sudo chown 1000:1000 <dir>
# GSM_BACKUP_DIR=./backups

# Optional. Model for bulk repository analysis. Default claude-haiku-5-5.
# CLAUDE_MODEL_BULK=claude-haiku-5-5

# Optional. Model for chat. Default claude-sonnet-5-5.
# CLAUDE_MODEL_CHAT=claude-sonnet-5-5

# Optional. Ask for confirmation when a bulk job is estimated to cost more than this many USD. Default 2.
# AI_SPEND_CONFIRM_USD=2

# Optional. Extra outbound hosts the server may call, comma separated. Default: built-in list only.
# OUTBOUND_ALLOWLIST=

# Optional. Express "trust proxy" value. Default uniquelocal (right for tailscale serve on loopback).
# TRUST_PROXY=uniquelocal

# Optional. Add "upgrade-insecure-requests" to the CSP. Default true (the page is served over https).
# CSP_UPGRADE_INSECURE_REQUESTS=true
